# ── Open-source AI (translation + service assistant) ─────────────────────────
# Any OpenAI-compatible server running an open-weight model. Recommended: Ollama + Qwen2.5
# (Apache-2.0, strong Arabic):   ollama pull qwen2.5:7b-instruct
OPEN_LLM_URL=http://localhost:11434/v1
OPEN_LLM_MODEL=qwen2.5:7b-instruct
# OPEN_LLM_API_KEY=            # only if your server requires one (vLLM --api-key, LocalAI)
# OPEN_LLM_TIMEOUT_MS=45000

# Optional literal fallback for translation: self-hosted LibreTranslate
#   docker run -p 5000:5000 libretranslate/libretranslate --load-only ar,en
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=

# ── Social feed (optional) ───────────────────────────────────────────────────
# Instagram posts on the home page need a long-lived Instagram Graph API token
# for the municipality's business account (Meta developer app).
# INSTAGRAM_ACCESS_TOKEN=
